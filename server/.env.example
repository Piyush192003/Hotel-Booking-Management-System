# ------------------------------------------------------------------
# WANDERLUST BACKEND (.env)
# Copy this file to .env and fill in real values. When credentials are
# absent the server automatically uses clearly-labelled development
# fallbacks (mock payments, local uploads, console email).
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MongoDB — use MongoDB Atlas in production. Leave MONGODB_URI empty and
# the server will attempt to fall back to mongodb://127.0.0.1:27017/wanderlust
MONGODB_URI=mongodb://127.0.0.1:27017/wanderlust

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email — leave empty for the Ethereal preview inbox (dev, no credentials).
# For real inbox delivery (e.g. Gmail): enable 2-Step Verification, create an
# App Password at https://myaccount.google.com/apppasswords, then set:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<you>@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Wanderlust <no-reply@wanderlust.dev>"

# Cloudinary — leave empty for local /uploads development mode
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — leave empty for MOCK payment mode (development only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps — leave empty for OpenStreetMap embed fallback
GOOGLE_MAPS_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Demo accounts — one-click "Guest User / Guest Owner" login on the login page
# needs these accounts to exist in MongoDB. The destructive `npm run seed`
# script is dev-only, so the server also bootstraps JUST these 3 accounts
# (non-destructively) on boot. Set SEED_DEMO_USERS=true on Render so the
# production database gets them too; everything else in the DB is untouched.
# Set to false to disable the bootstrap.
SEED_DEMO_USERS=true