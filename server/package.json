{
  "name": "@wanderlust/server",
  "version": "1.0.0",
  "private": true,
  "description": "Wanderlust REST API — Express + MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "node-cron": "^3.0.3",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^9.4.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
