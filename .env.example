# ------------------------------------------------------------------
# WANDERLUST — root environment reference
# Copy to server/.env for the backend (see server/.env.example for the
# complete annotated list). The client reads VITE_* variables from
# client/.env (see client/.env.example).
# ------------------------------------------------------------------

# Server port
PORT=5000

# CORS origin for the client
CLIENT_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas recommended)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/wanderlust
MONGODB_URI=mongodb://127.0.0.1:27017/wanderlust

# JWT secrets
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP). Leave empty to use the development "console/ethereal" mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Wanderlust <no-reply@wanderlust.dev>"

# Cloudinary (image storage). Leave empty to use local /uploads dev fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments). Leave empty for MOCK payment mode (dev only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Maps (used for map embeds). Leave empty for OpenStreetMap fallback.
GOOGLE_MAPS_API_KEY=

# Frontend base URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300